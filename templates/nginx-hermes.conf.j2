server {
    listen 80;
    server_name {{ hermes_nginx_fqdn }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ hermes_nginx_fqdn }};

{% if hermes_nginx_tls_enabled | bool %}
    ssl_certificate {{ hermes_nginx_tls_cert }};
    ssl_certificate_key {{ hermes_nginx_tls_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
{% endif %}
    client_max_body_size {{ hermes_nginx_client_max_body_size }};

{% if hermes_nginx_basic_auth_enabled | bool %}
    auth_basic "{{ hermes_nginx_basic_auth_realm }}";
    auth_basic_user_file {{ hermes_nginx_basic_auth_file }};
{% endif %}

    location / {
        proxy_pass http://127.0.0.1:{{ hermes_dashboard_port }};
        proxy_http_version 1.1;

        # Hermes dashboard validates Host/Origin against its bind target.
        # Keep upstream headers loopback even when the public vhost is a DNS alias.
        proxy_set_header Host 127.0.0.1:{{ hermes_dashboard_port }};
        proxy_set_header Origin "";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Dashboard Chat/TUI uses WebSocket endpoints under /api/.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Do not leak nginx Basic Auth credentials to the Hermes backend.
        proxy_set_header Authorization "";

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
    }
}
