map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

{% if hermes_nginx_http_enabled | bool %}
server {
    listen 80;
    server_name {{ hermes_nginx_vhost_fqdn | default(hermes_dashboard_nginx_fqdn) }};

{% if hermes_nginx_letsencrypt_enabled | bool and hermes_nginx_letsencrypt_challenge_method == 'webroot' %}
    location ^~ /.well-known/acme-challenge/ {
        root {{ hermes_nginx_letsencrypt_webroot }};
        default_type "text/plain";
        try_files $uri =404;
    }
{% endif %}

    location / {
        return 301 https://$host$request_uri;
    }
}
{% endif %}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ hermes_nginx_vhost_fqdn | default(hermes_dashboard_nginx_fqdn) }};

{% if hermes_nginx_tls_enabled | bool %}
    ssl_certificate {{ hermes_nginx_vhost_tls_cert | default(hermes_dashboard_nginx_tls_cert) }};
    ssl_certificate_key {{ hermes_nginx_vhost_tls_key | default(hermes_dashboard_nginx_tls_key) }};
    ssl_protocols TLSv1.2 TLSv1.3;
{% endif %}
    client_max_body_size {{ hermes_nginx_client_max_body_size }};

    location / {
        proxy_pass http://{{ hermes_nginx_vhost_host | default('127.0.0.1') }}:{{ hermes_nginx_vhost_port | default(hermes_dashboard_port) }};
        proxy_http_version 1.1;

{% if (hermes_nginx_vhost_preserve_public_host | default(false)) | bool %}
        # Preserve the browser-visible origin for WebUI CSRF/origin checks.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
{% else %}
        # Hermes dashboard validates Host/Origin against its bind target.
        # Use the configured backend address, not the public DNS alias.
        proxy_set_header Host {{ hermes_nginx_vhost_host | default('127.0.0.1') }}:{{ hermes_nginx_vhost_port | default(hermes_dashboard_port) }};
        proxy_set_header Origin "";
{% endif %}

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Dashboard Chat/TUI uses WebSocket endpoints under /api/. WebUI uses
        # streaming/long-running API responses. These headers are harmless for both.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
    }
}
