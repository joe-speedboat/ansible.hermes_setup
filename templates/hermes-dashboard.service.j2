[Unit]
Description=Hermes Agent Dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart={{ hermes_project_path }}/venv/bin/python -m hermes_cli.main dashboard --port {{ hermes_dashboard_port }} --host {{ hermes_dashboard_host }}{{ (hermes_dashboard_insecure | bool) | ternary(' --insecure', '') }}{{ (hermes_dashboard_extra_args | length > 0) | ternary(' ' + hermes_dashboard_extra_args, '') }}
WorkingDirectory={{ hermes_project_path }}
Environment="PATH={{ hermes_project_path }}/venv/bin:{{ hermes_project_path }}/node_modules/.bin:{{ hermes_home }}/.hermes/node/bin:{{ hermes_home }}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV={{ hermes_project_path }}/venv"
Environment="HERMES_HOME={{ hermes_config_dir }}"
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-dashboard

[Install]
WantedBy=default.target
